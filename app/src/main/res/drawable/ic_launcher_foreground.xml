<?xml version="1.0" encoding="utf-8"?>
<!--
    Flecha y barras en estilo "vidrio líquido": cuatro capas de los mismos trazos.
    1. Sombra cálida un poco más abajo.
    2. Borde blanco translúcido (más ancho).
    3. Cuerpo de vidrio con degradado de blanco a casi transparente.
    4. Brillo fino desplazado arriba a la izquierda.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Sombra -->
    <group android:translateY="2.2">
        <path
            android:pathData="M54,24L54,55M41,43L54,56L67,43"
            android:strokeWidth="7.5"
            android:strokeColor="#40B23A00"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M34,68L34,74M44,64L44,80M54,67L54,77M64,64L64,80M74,68L74,74"
            android:strokeWidth="6.5"
            android:strokeColor="#40B23A00"
            android:strokeLineCap="round" />
    </group>

    <!-- 2. Borde translúcido -->
    <path
        android:pathData="M54,24L54,55M41,43L54,56L67,43"
        android:strokeWidth="9"
        android:strokeColor="#4DFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M34,68L34,74M44,64L44,80M54,67L54,77M64,64L64,80M74,68L74,74"
        android:strokeWidth="8"
        android:strokeColor="#4DFFFFFF"
        android:strokeLineCap="round" />

    <!-- 3. Cuerpo de vidrio -->
    <path
        android:pathData="M54,24L54,55M41,43L54,56L67,43"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="54"
                android:endY="58"
                android:startX="54"
                android:startY="22"
                android:type="linear">
                <item android:color="#D9FFFFFF" android:offset="0" />
                <item android:color="#5CFFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M34,68L34,74M44,64L44,80M54,67L54,77M64,64L64,80M74,68L74,74"
        android:strokeWidth="5.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="54"
                android:endY="82"
                android:startX="54"
                android:startY="62"
                android:type="linear">
                <item android:color="#CCFFFFFF" android:offset="0" />
                <item android:color="#52FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. Brillo -->
    <group
        android:translateX="-1.1"
        android:translateY="-1.1">
        <path
            android:pathData="M54,25.5L54,50M43,43L50,50"
            android:strokeWidth="1.4"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" />
        <path
            android:pathData="M44,65.5L44,72M64,65.5L64,72M54,68.5L54,72M34,69.5L34,71M74,69.5L74,71"
            android:strokeWidth="1.2"
            android:strokeColor="#E6FFFFFF"
            android:strokeLineCap="round" />
    </group>
</vector>
